# ReBalance production configuration.
#
#   cp .env.example .env && chmod 600 .env      (setup-vm.sh does this and fills in the secrets)
#
# Read by `docker compose` (variable interpolation in docker-compose.yml) and by backup/*.sh.
# Never commit .env. Keep a copy of it (and of the rclone keys) in your password manager:
# you need it to restore backups on a rebuilt VM.
#
# Syntax: KEY=value, no spaces around "=". Quote values that contain spaces or "#".
# Generate secrets with:
#   openssl rand -hex 24          -> database passwords (hex = no quoting/URL issues)
#   openssl rand -base64 48       -> JWT_SECRET (base64 of 48 random bytes, >= 32 required)

# ---------------------------------------------------------------------------
# Public address (Caddy)
# ---------------------------------------------------------------------------
# Until a domain exists use sslip.io with the VM's public IPv4 (dots -> dashes):
#   SITE_ADDRESS=203-0-113-10.sslip.io
# With a real domain (A record -> VM public IP):
#   SITE_ADDRESS=rebalance.example.com
# After changing it: docker compose up -d web
SITE_ADDRESS=CHANGE-ME.sslip.io

# ---------------------------------------------------------------------------
# Database (MySQL 8.4, container "db", database "rebalance")
# ---------------------------------------------------------------------------
# Used by the db container on first initialisation and by backup/restore (root).
MYSQL_ROOT_PASSWORD=CHANGE-ME-openssl-rand-hex-24
# Application user; created automatically on first start of an empty db volume.
# Changing these later does NOT change the database - see README.md "Rotating secrets".
DB_USERNAME=rebalance
DB_PASSWORD=CHANGE-ME-openssl-rand-hex-24
# Optional override of the JDBC URL (default shown):
# DB_URL=jdbc:mysql://db:3306/rebalance?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# ---------------------------------------------------------------------------
# Backend (Spring Boot, profile "prod")
# ---------------------------------------------------------------------------
# Signs login tokens (app.jwt.secret). Base64 of >= 32 random bytes.
# Changing it logs everybody out.
JWT_SECRET=CHANGE-ME-openssl-rand-base64-48
# Comma-separated extra origins allowed by CORS (app.cors.allowed-origins).
# Leave EMPTY in production: the SPA is served from the same origin.
APP_CORS_ORIGINS=
# JVM options. Heap is fixed and pre-touched on purpose: it keeps the VM's memory
# utilisation above Oracle's 20% "idle instance" threshold (6 GB A1 shape) and avoids
# surprises later. Keep -Xmx below the 1536M container limit in docker-compose.yml.
JAVA_OPTS="-Xms768m -Xmx768m -XX:+AlwaysPreTouch -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError"

# ---------------------------------------------------------------------------
# Container images (normally leave commented: :latest is what CI pushes)
# ---------------------------------------------------------------------------
# Pin a specific build for a rollback (tags are git commit SHAs), then `docker compose up -d`.
# Remember to remove the pin again, otherwise later deploys keep using it.
# BACKEND_IMAGE=ghcr.io/vladkhrlmv/rebalance-backend:<git-sha>
# WEB_IMAGE=ghcr.io/vladkhrlmv/rebalance-web:<git-sha>

# ---------------------------------------------------------------------------
# Backups (backup/backup.sh, run nightly by rebalance-backup.timer)
# ---------------------------------------------------------------------------
# rclone destination "<remote>:<bucket>[/path]". Empty = local backups only, and the
# nightly job FAILS on purpose so you notice that nothing leaves the VM.
BACKUP_REMOTE=oci:rebalance-backups
# Days to keep backups, locally (deploy/backups/) and in the bucket.
BACKUP_RETENTION_DAYS=14
# Optional dead-man's switch, e.g. a free https://healthchecks.io check URL.
# Pinged on success, "<url>/fail" on failure; it e-mails you when a night is missed.
BACKUP_PING_URL=

# rclone remote "oci" = OCI Object Storage through its S3-compatible API.
# (rclone reads RCLONE_CONFIG_<REMOTE>_<OPTION> variables; backup.sh exports these.)
# - namespace: OCI Console -> Profile -> Tenancy -> "Object storage namespace"
# - region:    your home region identifier, e.g. eu-frankfurt-1
# - keys:      OCI Console -> Profile -> My profile -> Customer secret keys -> Generate secret key
#              (Access key = ACCESS_KEY_ID, the one-time-shown secret = SECRET_ACCESS_KEY)
RCLONE_CONFIG_OCI_TYPE=s3
RCLONE_CONFIG_OCI_PROVIDER=Other
RCLONE_CONFIG_OCI_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
RCLONE_CONFIG_OCI_REGION=<region>
RCLONE_CONFIG_OCI_ACCESS_KEY_ID=
RCLONE_CONFIG_OCI_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OCI_FORCE_PATH_STYLE=true
# The bucket is created in the Console; don't let rclone try to create/check it.
RCLONE_CONFIG_OCI_NO_CHECK_BUCKET=true
